\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces V4 multimodal architecture. The WaveNet+Mamba denoiser feeds two parallel branches: a ResNet metric embedder on the denoised waveform and a spectrogram Mamba branch with frequency- and time-axis sweeps. A gated self-attention fusion module fuses the two L2-normalized embeddings into a single 128-d biometric embedding. Auxiliary metric losses on each branch (dashed) prevent fusion collapse during joint training.}}{4}{}\protected@file@percent }
\newlabel{fig:v4-arch}{{1}{4}{}{figure.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {I}{\ignorespaces Best Precision@1 (P@1) per version and noise type. Higher is better. V3 is a single-seed quick run.}}{4}{}\protected@file@percent }
\newlabel{tab:cross}{{I}{4}{}{table.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {II}{\ignorespaces Cited prior-work numbers on EEG-based identification. Each row uses its source paper's protocol; no baseline is re-implemented under the AEP-Hybrid protocol of this paper. V4 results are in Table~\ref {tab:cross}.}}{4}{}\protected@file@percent }
\newlabel{tab:priorwork}{{II}{4}{}{table.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {V-C}}Ablation: Mamba and Multimodal Fusion}{4}{}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {III}{\ignorespaces V4 multimodal results, mean$\pm $std over three seeds. The ResNet-34+ArcFace head is the strongest by P@1 on all noise families.}}{4}{}\protected@file@percent }
\newlabel{tab:v4}{{III}{4}{}{table.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {IV}{\ignorespaces Architectural ablation on ResNet-34+ArcFace by P@1. $\Delta $ rows are V4 minus V1. Stage~I is retrained independently per version, so SI-SNR is not used here as an ablation metric.}}{4}{}\protected@file@percent }
\newlabel{tab:ablation}{{IV}{4}{}{table.4}{}}
